# Default mock mode has no external AI calls.
AI_PROVIDER=mock
# Real writing model: keep credentials server-only, never use NEXT_PUBLIC_.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TIMEOUT_MS=25000
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_CALLS_PER_DAY=50
AI_MAX_OUTPUT_TOKENS=6000
# Optional canonical HTTPS origin behind a reverse proxy (no trailing slash).
# APP_ORIGIN=https://your-domain.example
# OCR is not enabled in this text MVP.
